# Runtime environment
APP_ENV=local

# Storage backend: local for development, r2 later
STORAGE_BACKEND=local

# Local paths
LOCAL_DATA_DIR=data
DATABASE_URL=postgresql://divinheal:divinheal_dev_password@localhost:5433/divinheal_data

# Cloudflare R2 settings
# Leave empty for local development.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=

# HTTP settings
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3

# AI-assisted outbound medical travel estimate enrichment
ENABLE_AI_OUTBOUND_ESTIMATES=false
AI_OUTBOUND_ESTIMATE_MAX_ORIGINS=8
AI_OUTBOUND_ESTIMATE_REFRESH_CACHE=false
GEMINI_API_KEY=